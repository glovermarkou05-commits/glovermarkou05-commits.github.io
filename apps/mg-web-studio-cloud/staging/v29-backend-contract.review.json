  "idempotency": {
    "uniqueScope": [
      "organizationId",
      "authenticatedActorId",
      "Idempotency-Key"
    ],
    "requestFingerprintIncludes": [
      "method",
      "canonicalRoute",
      "organizationId",
      "siteId",
      "proposalId",
      "action",
      "expectedRevision",
      "expectedDraftVersion",
      "decisionPayload"
    ],
    "responseReplay": "after-fresh-auth-and-tenant-scope-check",
    "collision": "IDEMPOTENCY_CONFLICT",
    "storage": "future-server-transaction-only",
    "retention": "UNDECIDED_REQUIRES_POLICY",
    "forbiddenFingerprintFields": [
      "password",
      "accessToken",
      "secret",
      "authorizationHeader",
      "cookie",
      "sessionId"
    ]
  },
  "transaction": {
    "boundary": "single-future-PostgreSQL-transaction",
    "sequence": [
      "verify-authenticated-identity",
      "resolve-tenant-scope-and-resource",
      "check-server-role-and-mfa",
      "lock-or-cas-proposal-revision",
      "validate-status-transition",
      "write-proposal-and-draft-if-applicable",
      "write-operation-idempotency-receipt",
      "write-private-business-audit",
      "write-outbox-event",
      "commit-together"
    ],
    "rollback": "any-error-reverts-business-state-idempotency-receipt-and-outbox",
    "isolation": "NOT_DECIDED_PENDING_POSTGRES_CONCURRENCY_TEST",
    "implementationState": "NOT_IMPLEMENTED",
    "publishSite": false
  },
  "audit": {
    "businessLog": "private-tenant-scoped-after-verified-resource-ownership",
    "deniedSecurityLog": "separate-restricted-server-security-audit-no-unverified-target-tenant-association",
    "redact": [
      "credentials",
      "cookies",
      "tokens",
      "notes",
      "proposalBody",
      "paymentData",
      "rawUserInput"
    ],
    "actorTrust": "server-verified-only",
    "integrity": "UNPROVEN_REQUIRES_CRYPTOGRAPHIC_OR_IMMUTABLE_DESIGN",
    "securityLogging": "design-only",
    "clientCanWrite": false
  },
  "responses": {
    "success": {
      "format": "{ok:true,data:{...},requestId}",
      "serverMintsRequestId": true
    },
    "failure": {
      "format": "{ok:false,error:{code,message},requestId}",
      "serverMintsRequestId": true
    },
    "noSecretsInErrors": true,
    "noRawSqlMessages": true,
    "noOutboxPayloadOnClient": true
  },
