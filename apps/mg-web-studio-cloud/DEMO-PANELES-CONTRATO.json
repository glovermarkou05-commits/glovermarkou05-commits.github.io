{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "documentType": "MG_WEB_STUDIO_CLOUD_DEMO_MAPPING",
  "version": "1.0.0",
  "mode": "development-only",
  "note": "Declarativo para pruebas y migración futura: las dos maquetas HTML usan snapshots autocontenidos. Este archivo aún NO es un datastore compartido ni se consume por red.",
  "organizations": [
    {
      "id": "c1",
      "name": "Café Horizonte",
      "sites": [
        {
          "id": "s1",
          "name": "Café Horizonte",
          "exampleDomain": "cafe-horizonte.ejemplo.invalid",
          "previewFixture": true
        }
      ],
      "demoPlan": "Crece"
    },
    {
      "id": "c2",
      "name": "Papelería Nube",
      "sites": [
        {
          "id": "s2",
          "name": "Papelería Nube",
          "exampleDomain": "papeleria-nube.ejemplo.invalid",
          "previewFixture": true
        }
      ],
      "demoPlan": "Start"
    },
    {
      "id": "c3",
      "name": "Servicios Costa",
      "sites": [],
      "demoPlan": "Pro",
      "previewFixture": false
    }
  ],
  "roles": [
    "CLIENT_OWNER",
    "CLIENT_ADMIN",
    "CLIENT_EDITOR",
    "CLIENT_VIEWER"
  ],
  "portalNavigation": {
    "relativePath": "./portal-cliente.html",
    "parameter": "mgdemo",
    "syntax": "clientId.siteId.ROLE",
    "additionalPlanParameter": "mgplan",
    "allowlistedPlans": [
      "Start",
      "Crece",
      "Pro"
    ],
    "securityStatus": "NO AUTHENTICATION"
  },
  "boundaries": {
    "persistentSharedState": false,
    "backend": false,
    "authentication": false,
    "realPermissions": false,
    "noRealUserData": true,
    "noExternalRequests": true,
    "noPublication": true
  }
}
